{
  "name": "frshly",
  "version": "0.1.0",
  "description": "Deploy. Open tabs update themselves. No hard refresh. No 'please clear your cache'.",
  "license": "MIT",
  "author": "frshly contributors",
  "keywords": [
    "react",
    "version",
    "deployment",
    "cache",
    "refresh",
    "reload",
    "stale",
    "vite",
    "webpack",
    "spa",
    "update",
    "version-check",
    "auto-reload"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/frshly.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/frshly/issues"
  },
  "homepage": "https://github.com/yourusername/frshly#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js",
      "require": "./dist/webpack.cjs"
    },
    "./craco": {
      "types": "./dist/craco.d.ts",
      "import": "./dist/craco.js",
      "require": "./dist/craco.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/verify-build.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.2.0",
    "eslint": "^8.56.0",
    "happy-dom": "^12.10.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.2.0",
    "webpack": "^5.89.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
